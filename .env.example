# Copy this file to .env.local and fill in your Azure App Registration (SPA) client id.
# See README.md → "Azure App Registration" for step-by-step setup.
VITE_MSAL_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Google Cloud OAuth client, type Web application. See README.
VITE_GOOGLE_CLIENT_ID=
# Server only. Never prefix the secret with VITE_. Prefer the downloaded OAuth JSON.
GOOGLE_OAUTH_CLIENT_FILE=
# Alternatively: GOOGLE_CLIENT_SECRET=
